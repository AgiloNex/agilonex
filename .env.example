# ============================================================
# .env.example — copie este arquivo para .env e preencha com
# seus valores reais. NUNCA comite o .env no repositório.
# ============================================================

# Supabase Configuration
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SEU_ANON_KEY_PUBLICO_DO_SUPABASE

# ⚠️  ATENÇÃO — SEGURANÇA CRÍTICA ⚠️
# As chaves de AI NÃO devem ser definidas aqui se você usa um proxy server-side.
# Se você está chamando as APIs diretamente do browser (sem proxy), as chaves
# ficam expostas no bundle JS para qualquer visitante.
# Recomendação: implemente um Cloudflare Worker / Supabase Edge Function que
# mantém as chaves no servidor e exponha somente um endpoint /api/ai/*.
#
# Se ainda assim precisar de chaves client-side (apenas para testes locais):
# VITE_OPENAI_API_KEY=sk-COLE_SUA_CHAVE_OPENAI_AQUI
# VITE_ANTHROPIC_API_KEY=sk-ant-COLE_SUA_CHAVE_ANTHROPIC_AQUI

# API Base URL (se usar um backend próprio)
VITE_API_BASE_URL=http://localhost:3000

# Google AdSense — substitua pelo seu Publisher ID após aprovação
VITE_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# Webhook para o formulário de contato (n8n, Make, Zapier etc.)
VITE_WEBHOOK_URL=https://SEU_WEBHOOK_URL
